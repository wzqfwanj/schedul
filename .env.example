# 复制为 .env 或直接导出为环境变量；生产环境务必修改账号密码。

# 登录账号 / 密码（默认 admin / admin123，仅供本机体验）
APP_USERNAME=admin
APP_PASSWORD=change-me

# Flask 会话签名密钥；留空则首次启动自动生成到 data/secret_key
SECRET_KEY=

# 数据目录（SQLite 与截图），默认 ./data
DATA_DIR=

# 时区，决定“今天”与截图时间显示
APP_TZ=Asia/Shanghai

# 通过 HTTPS 访问时设为 1（Cookie 仅 HTTPS 传输）
COOKIE_SECURE=0

# 监听地址：本机默认 127.0.0.1；容器内可设 0.0.0.0
HOST=127.0.0.1
PORT=8000
